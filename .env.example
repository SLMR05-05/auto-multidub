# MySQL
DB_URL=jdbc:mysql://localhost:3306/multilingual_travel_guide?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# JWT: replace with a random secret of at least 32 bytes
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_MS=86400000

# Google Cloud
GOOGLE_CLOUD_PROJECT_ID=your-google-cloud-project-id
# Set GOOGLE_APPLICATION_CREDENTIALS in Windows environment to your service-account JSON path.

# Optional first admin (created only if it does not exist)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=System Admin

SERVER_PORT=8080
AUDIO_DIRECTORY=./storage/audio
